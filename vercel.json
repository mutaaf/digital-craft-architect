{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(app|app-cto).webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(beta|cto-beta)\\.digitalcraftai\\.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/vendor/aurora-field@:version/:file",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/feeds.opml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/chalktalk/:path*",
      "destination": "https://mutaafaziz.com/chalktalk/api/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/:path(construction|realestate|events|setupclaw|blog|classes)(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i)(facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Applebot|Discordbot|Googlebot|bingbot|PetalBot|Bytespider)"
        },
        {
          "type": "query",
          "key": "site",
          "value": "(?<site>.+)"
        }
      ],
      "destination": "/api/og?path=/:path$2&site=:site"
    },
    {
      "source": "/:path(construction|realestate|events|setupclaw|blog|classes)(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i)(facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Applebot|Discordbot|Googlebot|bingbot|PetalBot|Bytespider)"
        }
      ],
      "destination": "/api/og?path=/:path$2"
    },
    {
      "source": "/:path(construction|realestate|events|setupclaw|blog|classes)(.*)",
      "destination": "/api/og-html?path=/:path$2"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
